# ─── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-app.railway.app
DEFAULT_ORG_ID=your-default-org-uuid

# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
# Direct PostgreSQL connection — required for server-side migrations on startup.
# Find this in Supabase dashboard → Settings → Database → Connection string (URI mode).
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── WhatsApp Business API (Meta) ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
WHATSAPP_APP_SECRET=your_app_secret_for_signature_validation

# ─── Africa's Talking (SMS) ────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_SENDER_ID=AirPay
AT_ENVIRONMENT=production

# ─── Email (SMTP via Nodemailer) ───────────────────────────────
SMTP_HOST=mail.airpayglobal.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=connect@airpayglobal.com
SMTP_PASS=your_email_password
EMAIL_FROM_ADDRESS=connect@airpayglobal.com
EMAIL_FROM_NAME=AirPay Global

# ─── Queue & Rate Limiting ─────────────────────────────────────
QUEUE_CONCURRENCY=5
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000
RATE_LIMIT_PER_MINUTE=60

# ─── Security ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
WEBHOOK_SIGNING_SECRET=your_signing_secret

# ─── Anthropic AI ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
