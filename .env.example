# ─── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-app.railway.app
DEFAULT_ORG_ID=your-default-org-uuid

# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ─── WhatsApp Business API (Meta) ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
WHATSAPP_APP_SECRET=your_app_secret_for_signature_validation

# ─── Africa's Talking (SMS) ────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_SENDER_ID=AirPay
AT_ENVIRONMENT=production

# ─── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=campaigns@airpay.com.na
RESEND_FROM_NAME=AirPay
RESEND_INBOUND_WEBHOOK_SECRET=your_inbound_webhook_secret

# ─── Queue & Rate Limiting ─────────────────────────────────────
QUEUE_CONCURRENCY=5
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000
RATE_LIMIT_PER_MINUTE=60

# ─── Security ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
WEBHOOK_SIGNING_SECRET=your_signing_secret
