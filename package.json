{
  "name": "airpay-campaign-manager",
  "version": "1.0.0",
  "description": "AirPay Multi-Channel Campaign Management Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cd client && npm run build",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:prod": "node dist/index.js",
    "worker": "node dist/worker.js",
    "db:migrate": "supabase db push",
    "lint": "eslint src/**/*.ts",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@supabase/supabase-js": "^2.39.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "africastalking": "^0.5.4",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
